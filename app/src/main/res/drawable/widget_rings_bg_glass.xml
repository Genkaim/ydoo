<?xml version="1.0" encoding="utf-8"?>
<!--
  Card background for domestic OEM launchers (MIUI/HyperOS, ColorOS, OriginOS…):
  a frosted card — mostly opaque so the wallpaper only tints it, with a wide
  sheen from the top edge, a soft glow along the bottom and a bright rim.
  A real backdrop blur is not available to RemoteViews; the frost is painted
  with a translucent fill and gradients.
  Pixel and other AOSP-like launchers keep the plain opaque card.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#B8FFFFFF" />
            <corners android:radius="40dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <gradient
                android:angle="270"
                android:endColor="#00FFFFFF"
                android:startColor="#4DFFFFFF" />
            <corners android:radius="40dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <gradient
                android:angle="90"
                android:endColor="#14FFFFFF"
                android:startColor="#00FFFFFF" />
            <corners android:radius="40dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <stroke
                android:width="1dp"
                android:color="#B3FFFFFF" />
            <corners android:radius="40dp" />
        </shape>
    </item>
</layer-list>
