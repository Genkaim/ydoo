<?xml version="1.0" encoding="utf-8"?>
<!--
  Card background for domestic OEM launchers (MIUI/HyperOS, ColorOS, OriginOS…):
  the same translucent surface, plus a thin bright rim and a soft sheen falling
  from the top edge — the "liquid glass" look those systems use everywhere.
  Pixel and other AOSP-like launchers keep the plain card.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#E6FFFFFF" />
            <corners android:radius="40dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <gradient
                android:angle="270"
                android:endColor="#00FFFFFF"
                android:startColor="#4DFFFFFF" />
            <corners android:radius="40dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <stroke
                android:width="1dp"
                android:color="#8CFFFFFF" />
            <corners android:radius="40dp" />
        </shape>
    </item>
</layer-list>
