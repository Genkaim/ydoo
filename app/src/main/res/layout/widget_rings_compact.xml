<?xml version="1.0" encoding="utf-8"?>
<!--
  One-row variant, used when the launcher gives the widget a single cell of
  height. Same data and colours as the full card; the ring labels are dropped
  because at 70dp there is no room for a caption above each ring.

  The logo sits at the left, the three rings share the rest of the width, so the
  card stays readable at 4×1 instead of showing a clipped 4×2.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_rings_bg"
    android:forceDarkAllowed="false"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="10dp">

    <ImageView
        android:id="@+id/widget_logo"
        android:layout_width="wrap_content"
        android:layout_height="14dp"
        android:layout_marginEnd="6dp"
        android:adjustViewBounds="true"
        android:contentDescription="@string/app_name"
        android:scaleType="fitStart"
        android:src="@drawable/brand_mark"
        android:tint="@color/widget_on_surface" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/widget_sleep_frame"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/widget_sleep_ring"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/widget_sleep_value"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="@color/widget_on_surface"
                android:textSize="13sp"
                android:textStyle="bold" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/widget_charge_frame"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/widget_charge_ring"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/widget_charge_value"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="@color/widget_on_surface"
                android:textSize="13sp"
                android:textStyle="bold" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/widget_load_frame"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/widget_load_ring"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/widget_load_value"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="@color/widget_on_surface"
                android:textSize="13sp"
                android:textStyle="bold" />
        </FrameLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/widget_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:maxLines="1"
        android:textColor="@color/widget_muted"
        android:textSize="10sp" />
</LinearLayout>
