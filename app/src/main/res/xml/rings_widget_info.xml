<?xml version="1.0" encoding="utf-8"?>
<!--
  4×2. The numbers follow the classic Android formula (one cell ≈ 70×70dp,
  minus 30dp of margin): 4 columns → 250dp, 2 rows → 110dp. Xiaomi's own table
  quotes 300dp for its widget platform, but that lands on five cells in grids
  whose cell is ~70dp wide, so 250dp is the value that resolves to 4×2 on MIUI,
  HyperOS, ColorOS, OriginOS and One UI alike.

  Note: Xiaomi's App Vault (负一屏) does not accept standard Android widgets at
  all — its picker only lists 小米小部件 published through Xiaomi's platform.
  No manifest attribute changes that; the card is meant for the desktop, and
  every other OEM's widget host can place it.

  previewLayout is what Android 12+ pickers draw; previewImage is the fallback
  for older launchers and OEM pickers that ignore previewLayout.
  minResize* keeps the card from being squeezed below the point where three
  rings still fit.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_rings_description"
    android:initialLayout="@layout/widget_rings_v5"
    android:minHeight="70dp"
    android:minResizeHeight="64dp"
    android:minResizeWidth="200dp"
    android:minWidth="250dp"
    android:previewImage="@drawable/widget_preview"
    android:previewLayout="@layout/widget_rings_v5"
    android:resizeMode="horizontal|vertical"
    android:targetCellHeight="1"
    android:targetCellWidth="4"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen" />
