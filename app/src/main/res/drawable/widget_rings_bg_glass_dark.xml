<?xml version="1.0" encoding="utf-8"?>
<!--
  Domestic OEM card in the app dark theme.
  The rim lives on the same <shape> as the fill: a stroke on its own layer is
  inset by half its width, so at the 40dp corners it left a pale hairline just
  outside the card edge. One path draws fill and rim together, so the highlight
  hugs the corner exactly. The rim is a low white alpha, which reads as dark grey
  on a dark card, with a faint sheen at the top and a glow at the bottom.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#B817181C" />
            <stroke
                android:width="1.5dp"
                android:color="#26FFFFFF" />
            <corners android:radius="40dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <gradient
                android:angle="270"
                android:endColor="#00FFFFFF"
                android:startColor="#1FFFFFFF" />
            <corners android:radius="40dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <gradient
                android:angle="90"
                android:endColor="#0AFFFFFF"
                android:startColor="#00FFFFFF" />
            <corners android:radius="40dp" />
        </shape>
    </item>
</layer-list>
