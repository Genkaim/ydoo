<?xml version="1.0" encoding="utf-8"?>
<!-- Domestic OEM card in the app dark theme: mostly opaque dark surface, top
     sheen, bottom glow and a bright rim. See the light file for why the frost is
     painted rather than blurred. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#B817181C" />
            <corners android:radius="40dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <gradient
                android:angle="270"
                android:endColor="#00FFFFFF"
                android:startColor="#2EFFFFFF" />
            <corners android:radius="40dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <gradient
                android:angle="90"
                android:endColor="#0FFFFFFF"
                android:startColor="#00FFFFFF" />
            <corners android:radius="40dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <stroke
                android:width="1dp"
                android:color="#59FFFFFF" />
            <corners android:radius="40dp" />
        </shape>
    </item>
</layer-list>
