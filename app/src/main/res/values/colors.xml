      setting, which is independent of the system configuration.
    -->
    <color name="widget_surface_dark">#17181C</color>
    <color name="widget_on_surface_dark">#ECECEE</color>
    <color name="widget_muted_dark">#A0A2AA</color>
    <color name="widget_primary_dark">#48D69B</color>
    <color name="widget_tertiary_dark">#8FA6FF</color>
