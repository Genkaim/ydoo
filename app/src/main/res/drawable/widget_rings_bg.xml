<?xml version="1.0" encoding="utf-8"?>
<!--
  Plain card (Pixel and AOSP-like launchers): opaque surface, no rim, no sheen.
  The frosted treatment is reserved for the domestic OEM skins, so the two do
  not look like the same widget with a stray border.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/widget_surface" />
    <corners android:radius="40dp" />
</shape>
